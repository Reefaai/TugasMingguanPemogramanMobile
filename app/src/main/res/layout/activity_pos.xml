<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Top Store Bar (Pembeda UI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackToMain"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kembali ke Lab 1"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="@color/pos_primary_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMART POS TERMINAL KASIR"
                        android:textColor="@color/pos_primary_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IKMI Smart Mart • Register #04"
                        android:textColor="@color/pos_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Live Retry Badge (Pembeda UI Tugas 1) -->
                <TextView
                    android:id="@+id/tvRetryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_tag"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Retry: 0 / 3"
                    android:textColor="@color/pos_primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Title & Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kasir Mandiri Berketahanan Tinggi"
                android:textColor="@color/pos_text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Simulasi Resilient Architecture: Coroutine Exception &amp; Retry Pattern"
                android:textColor="@color/pos_text_muted"
                android:textSize="12sp" />

            <!-- Input Barcode Section Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/pos_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pos_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pindai / Masukkan Barcode Produk"
                        android:textColor="@color/pos_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Barcode Input Field -->
                    <EditText
                        android:id="@+id/etBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Pindai / Masukkan Barcode (Cth: 8991201)"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/pos_text_dark"
                        android:textColorHint="@color/pos_text_subtle"
                        android:textSize="14sp" />

                    <!-- Quick Preset Scanner Chips (Pembeda UI) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pindai Cepat (Quick Preset Barcode):"
                        android:textColor="@color/pos_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipUhtMilk"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="🥛 Susu UHT 1L (21.5k)"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipNotFound"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="🔍 Barcode Rusak [404]"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipTimeout"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="🌐 Putus Jaringan [Timeout]"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/chipOverLimit"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="💎 Grosir >10jt [Tugas 2]"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Simulation Radio Group -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Pilihan Simulasi Eksepsi Server &amp; Jaringan:"
                        android:textColor="@color/pos_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgSimulation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbSuccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Simulasi Transaksi Normal (Berhasil)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbBarcodeError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Error 404 (Barcode Tidak Ditemukan)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbNetworkTimeout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Error Jaringan (Payment Timeout)"
                            android:textSize="13sp" />

                        <!-- Pembeda UI: Radio Option untuk Tugas 2 -->
                        <RadioButton
                            android:id="@+id/rbCashierLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Limit Kasir > Rp 10.000.000 (Tugas Mandiri 2)"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <!-- Payment Button -->
                    <Button
                        android:id="@+id/btnProcessPayment"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@color/pos_primary"
                        android:text="Proses Pembayaran Transaksi"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/pbPosLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="@color/pos_primary"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Hasil Transaksi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPosResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pos_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPosStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TRANSAKSI BERHASIL (LUNAS)"
                            android:textColor="@color/pos_success"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPosPaymentMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_tag"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="QRIS SETTLED"
                            android:textColor="@color/pos_primary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/pos_stroke" />

                    <TextView
                        android:id="@+id/tvPosDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="Detail transaksi akan tampil di sini..."
                        android:textColor="@color/pos_text_medium"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnResetTransaction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:text="Transaksi Baru"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Timber Audit Console (Pembeda UI Praktikum) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ LIVE TIMBER AUDIT LOG"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTimberTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TAG: PosActivity"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLiveLogOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:text="[Ready] Menunggu interaksi kasir..."
                        android:textColor="#F1F5F9"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
